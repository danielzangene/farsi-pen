# Copy to .env.local for local development (never commit .env.local).
# Both values are public: they ship to the browser. Never put the service_role / secret key here.

# Google sign-in via Supabase Auth. Leave empty to run the app without sign-in.
# Supabase dashboard → Project Settings → API (Project URL, Publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Cloudflare Worker (AI tutor, sync, feedback); see worker/README.md.
NEXT_PUBLIC_API_URL=
